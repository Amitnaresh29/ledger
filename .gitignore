# --- Maven build output ---
# Regenerated by every build from source. Never commit compiled artifacts.
target/

# --- IDE / editor state ---
# Local layout, caches and per-machine paths. Not part of the project.
.idea/
*.iml
.vscode/
.kiro/
.classpath
.project
.settings/

# --- OS noise ---
.DS_Store
Thumbs.db

# --- logs ---
*.log

# --- local secrets and overrides ---
# Real credentials NEVER go in the repo. Keep machine-specific config here.
.env
application-local.properties
